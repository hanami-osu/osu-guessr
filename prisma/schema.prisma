generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum GameMode {
  background
  audio
  skin
}

enum GameVariant {
  classic
  survival
  death
}

enum GameRunType {
  standard
  daily
  challenge
  practice
}

enum GameEndReason {
  completed
  failed
  quit
  content_exhausted
}

enum GameRoundResult {
  guess
  skip
  timeout
}

enum GameItemType {
  mapset
  skin
}

enum GameChallengeType {
  daily
  shared
}

enum ReportType {
  incorrect_title
  inappropriate_content
  wrong_audio
  wrong_background
  other
}

enum ReportStatus {
  pending
  investigating
  resolved
  rejected
}

model User {
  banchoId  Int      @id @map("bancho_id")
  username  String   @db.VarChar(255)
  avatarUrl String   @map("avatar_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([username], map: "idx_username")
  @@map("users")
}

model Badge {
  name      String   @id @db.VarChar(255)
  color     String   @db.VarChar(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("badges")
}

model UserBadge {
  userId    Int      @map("user_id")
  badgeName String   @map("badge_name") @db.VarChar(255)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamp(0)

  @@id([userId, badgeName])
  @@map("user_badges")
}

model ApiKey {
  id       String    @id @db.VarChar(64)
  userId   Int       @map("user_id")
  name     String    @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  lastUsed DateTime? @map("last_used") @db.Timestamp(0)

  @@index([userId], map: "user_id_idx")
  @@index([lastUsed], map: "idx_api_keys_last_used")
  @@map("api_keys")
}

model UserAchievement {
  userId              Int         @map("user_id")
  gameMode            GameMode    @map("game_mode")
  variant             GameVariant @default(classic)
  rulesetVersion      Int         @default(0) @map("ruleset_version") @db.UnsignedSmallInt
  ppVersion           Int         @default(0) @map("pp_version") @db.UnsignedSmallInt
  totalScore          BigInt      @default(0) @map("total_score")
  gamesPlayed         Int         @default(0) @map("games_played") @db.UnsignedInt
  roundsPlayed        Int         @default(0) @map("rounds_played") @db.UnsignedInt
  totalCorrect        Int         @default(0) @map("total_correct") @db.UnsignedInt
  totalSkips          Int         @default(0) @map("total_skips") @db.UnsignedInt
  totalTimeouts       Int         @default(0) @map("total_timeouts") @db.UnsignedInt
  totalResponseTimeMs BigInt      @default(0) @map("total_response_time_ms") @db.UnsignedBigInt
  highestStreak       Int         @default(0) @map("highest_streak") @db.UnsignedInt
  highestScore        Int         @default(0) @map("highest_score")
  bestRunPp           Decimal     @default(0) @map("best_run_pp") @db.Decimal(12, 3)
  profilePp           Decimal     @default(0) @map("profile_pp") @db.Decimal(12, 3)
  lastPlayed          DateTime    @default(now()) @map("last_played") @db.DateTime(3)

  @@unique([userId, gameMode, variant, rulesetVersion, ppVersion], map: "user_game_mode_variant_version")
  @@index([gameMode, variant, rulesetVersion, ppVersion, profilePp], map: "idx_achievements_mode_pp")
  @@index([variant, rulesetVersion, ppVersion, profilePp], map: "idx_achievements_global_pp")
  @@index([totalScore], map: "idx_user_achievements_score")
  @@index([userId, totalScore], map: "idx_achievements_user_score")
  @@index([gameMode, variant, totalScore], map: "idx_achievements_mode_variant_score")
  @@map("user_achievements")
}

model Game {
  id                  BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  sessionId           String?       @unique(map: "unique_game_session") @map("session_id") @db.Char(36)
  userId              Int           @map("user_id")
  gameMode            GameMode      @map("game_mode")
  points              Int           @default(0)
  streak              Int           @default(0) @db.UnsignedInt
  variant             GameVariant   @default(classic)
  runType             GameRunType   @default(standard) @map("run_type")
  challengeId         String?       @map("challenge_id") @db.Char(36)
  seed                String?       @db.VarChar(128)
  configSnapshot      Json?         @map("config_snapshot")
  ranked              Boolean       @default(true)
  rulesetVersion      Int           @default(0) @map("ruleset_version") @db.UnsignedSmallInt
  ppVersion           Int           @default(0) @map("pp_version") @db.UnsignedSmallInt
  pp                  Decimal       @default(0) @db.Decimal(12, 3)
  roundsPlayed        Int           @default(0) @map("rounds_played") @db.UnsignedInt
  correctCount        Int           @default(0) @map("correct_count") @db.UnsignedInt
  skipCount           Int           @default(0) @map("skip_count") @db.UnsignedInt
  timeoutCount        Int           @default(0) @map("timeout_count") @db.UnsignedInt
  totalResponseTimeMs BigInt        @default(0) @map("total_response_time_ms") @db.UnsignedBigInt
  startedAt           DateTime      @default(now()) @map("started_at") @db.DateTime(3)
  endedAt             DateTime      @default(now()) @map("ended_at") @db.DateTime(3)
  endReason           GameEndReason @default(completed) @map("end_reason")

  @@index([userId, gameMode], map: "idx_games_user_mode")
  @@index([endedAt], map: "idx_games_ended")
  @@index([gameMode, points], map: "idx_games_mode_points")
  @@index([rulesetVersion, ranked, gameMode, variant], map: "idx_games_competitive")
  @@index([userId, gameMode, variant, rulesetVersion, ppVersion, ranked, pp], map: "idx_games_user_performance")
  @@index([challengeId], map: "idx_games_challenge")
  @@map("games")
}

model GameRound {
  id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  gameId             BigInt          @map("game_id") @db.UnsignedBigInt
  roundNumber        Int             @map("round_number") @db.UnsignedInt
  itemType           GameItemType    @map("item_type")
  itemId             Int             @map("item_id") @db.UnsignedInt
  submittedGuess     String?         @map("submitted_guess") @db.VarChar(500)
  answerSnapshot     String          @map("answer_snapshot") @db.VarChar(500)
  resultType         GameRoundResult @map("result_type")
  correct            Boolean
  responseTimeMs     Int             @map("response_time_ms") @db.UnsignedInt
  timeLimitMs        Int?            @map("time_limit_ms") @db.UnsignedInt
  pointsEarned       Int             @default(0) @map("points_earned")
  streakBefore       Int             @default(0) @map("streak_before") @db.UnsignedInt
  streakAfter        Int             @default(0) @map("streak_after") @db.UnsignedInt
  difficultySnapshot Decimal?        @map("difficulty_snapshot") @db.Decimal(8, 4)
  contentSnapshot    Json?           @map("content_snapshot")

  @@unique([gameId, roundNumber], map: "game_round_number")
  @@index([itemType, itemId], map: "idx_game_rounds_item")
  @@index([correct, responseTimeMs], map: "idx_game_rounds_correct_time")
  @@map("game_rounds")
}

model GameChallenge {
  id             String            @id @db.Char(36)
  challengeType  GameChallengeType @map("challenge_type")
  creatorUserId  Int?              @map("creator_user_id")
  sourceGameId   BigInt?           @map("source_game_id") @db.UnsignedBigInt
  gameMode       GameMode          @map("game_mode")
  variant        GameVariant       @default(classic)
  rulesetVersion Int               @map("ruleset_version") @db.UnsignedSmallInt
  ppVersion      Int               @map("pp_version") @db.UnsignedSmallInt
  seed           String            @db.VarChar(128)
  configSnapshot Json?             @map("config_snapshot")
  roundCount     Int?              @map("round_count") @db.UnsignedInt
  timerMs        Int?              @map("timer_ms") @db.UnsignedInt
  ranked         Boolean           @default(true)
  dailyDate      DateTime?         @map("daily_date") @db.Date
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([dailyDate, gameMode, variant], map: "daily_challenge_mode_variant")
  @@index([creatorUserId], map: "idx_game_challenges_creator")
  @@index([sourceGameId], map: "idx_game_challenges_source_game")
  @@map("game_challenges")
}

model GameChallengeRound {
  challengeId       String       @map("challenge_id") @db.Char(36)
  roundNumber       Int          @map("round_number") @db.UnsignedInt
  itemType          GameItemType @map("item_type")
  itemId            Int          @map("item_id") @db.UnsignedInt
  answerSnapshot    String       @map("answer_snapshot") @db.VarChar(500)
  difficultySnapshot Decimal?    @map("difficulty_snapshot") @db.Decimal(8, 4)
  contentSnapshot   Json?        @map("content_snapshot")

  @@id([challengeId, roundNumber])
  @@index([itemType, itemId], map: "idx_game_challenge_rounds_item")
  @@map("game_challenge_rounds")
}

model ContentStat {
  gameMode            GameMode     @map("game_mode")
  itemType            GameItemType @map("item_type")
  itemId              Int          @map("item_id") @db.UnsignedInt
  rulesetVersion      Int          @map("ruleset_version") @db.UnsignedSmallInt
  ppVersion           Int          @map("pp_version") @db.UnsignedSmallInt
  appearances         BigInt       @default(0) @db.UnsignedBigInt
  correctCount        BigInt       @default(0) @map("correct_count") @db.UnsignedBigInt
  skipCount           BigInt       @default(0) @map("skip_count") @db.UnsignedBigInt
  timeoutCount        BigInt       @default(0) @map("timeout_count") @db.UnsignedBigInt
  totalResponseTimeMs BigInt       @default(0) @map("total_response_time_ms") @db.UnsignedBigInt
  fastestCorrectMs    Int?         @map("fastest_correct_ms") @db.UnsignedInt
  empiricalDifficulty Decimal?     @map("empirical_difficulty") @db.Decimal(8, 4)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([gameMode, itemType, itemId, rulesetVersion, ppVersion])
  @@map("content_stats")
}

model ContentStatContribution {
  userId         Int             @map("user_id")
  gameMode       GameMode        @map("game_mode")
  itemType       GameItemType    @map("item_type")
  itemId         Int             @map("item_id") @db.UnsignedInt
  rulesetVersion Int             @map("ruleset_version") @db.UnsignedSmallInt
  ppVersion      Int             @map("pp_version") @db.UnsignedSmallInt
  correct        Boolean
  resultType     GameRoundResult @map("result_type")
  responseTimeMs Int             @map("response_time_ms") @db.UnsignedInt
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  @@id([userId, gameMode, itemType, itemId, rulesetVersion, ppVersion])
  @@index([gameMode, itemType, itemId, rulesetVersion, ppVersion], map: "idx_content_stat_contributions_item")
  @@map("content_stat_contributions")
}

model MapsetTag {
  mapsetId      Int     @id @map("mapset_id")
  imageFilename String? @map("image_filename") @db.VarChar(255)
  audioFilename String? @map("audio_filename") @db.VarChar(255)

  @@map("mapset_tags")
}

model MapsetData {
  mapsetId      Int       @id @map("mapset_id")
  title         String?   @db.VarChar(500)
  artist        String?   @db.VarChar(500)
  mapper        String?   @db.VarChar(500)
  rankedAt      DateTime? @map("ranked_at") @db.DateTime(3)
  starRatingMin Decimal?  @map("star_rating_min") @db.Decimal(6, 3)
  starRatingMax Decimal?  @map("star_rating_max") @db.Decimal(6, 3)

  @@index([title], map: "idx_mapset_data_title")
  @@index([artist], map: "idx_mapset_data_artist")
  @@index([mapper], map: "idx_mapset_data_mapper")
  @@index([rankedAt], map: "idx_mapset_data_ranked_at")
  @@index([starRatingMin, starRatingMax], map: "idx_mapset_data_star_rating")
  @@map("mapset_data")
}

model Skin {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  imageFilename String   @map("image_filename") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("skins")
}

model Report {
  id                Int          @id @default(autoincrement())
  userId            Int          @map("user_id")
  mapsetId          Int          @map("mapset_id")
  reportType        ReportType   @map("report_type")
  description       String?      @db.Text
  status            ReportStatus @default(pending)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  githubIssueNumber Int?         @map("github_issue_number")
  githubIssueUrl    String?      @map("github_issue_url") @db.VarChar(255)

  @@index([status], map: "idx_reports_status")
  @@index([userId], map: "idx_reports_user")
  @@index([mapsetId], map: "idx_reports_mapset")
  @@map("reports")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("announcements")
}
